# Copy to `.env.local` for local Next.js development.
# Never commit real secrets. Convex-only vars also belong in the Convex dashboard
# (Dashboard → Deployment → Environment Variables) for `npx convex dev` / production.

# --- Convex (filled by `npx convex dev`) ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Google OAuth (Convex Auth) ---
# Create credentials in Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# --- Resend (email OTP + night reminders) ---
# https://resend.com → API Keys
AUTH_RESEND_KEY=re_xxxxxxxx
# Optional: verified sender. Defaults to Resend onboarding address in code.
AUTH_RESEND_FROM=Movie Night <onboarding@resend.dev>

# --- TMDB (Next.js `/api/tmdb/*` routes) ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token

# --- App / Convex extras (set in Convex dashboard for backend) ---
# Public site URL used in reminder emails and OAuth redirects
SITE_URL=https://www.whopickedthis.app
# Optional: marks this email as app owner (admin actions)
APP_OWNER_EMAIL=you@example.com

# Resend sender after domain verify (Convex env)
# AUTH_RESEND_FROM=Movie Night <noreply@whopickedthis.app>
